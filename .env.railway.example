# ==============================================================================
# Railway Environment Variables Template for HRMS
# Paste these into your Railway Web Service "Variables" tab (Raw Editor or Key-Value)
# ==============================================================================

APP_NAME=HRMS
APP_ENV=production
APP_DEBUG=false

# Generate with: php artisan key:generate --show
APP_KEY=

# Railway automatically provisions a public domain; use Railway variable reference:
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL Plugin on Railway)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
# Railway Postgres connection reference:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ------------------------------------------------------------------------------
# Sessions, Cache & Queues (Use PostgreSQL Database tables)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# File Storage Options
# ------------------------------------------------------------------------------
# OPTION A: Persistent Railway Volume (Mount path: /var/www/html/storage/app/public)
FILESYSTEM_DISK=public

# OPTION B: Cloudflare R2 / AWS S3 (Uncomment if using S3/R2 storage)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=hrms-uploads
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=

# ------------------------------------------------------------------------------
# Initial Seeding
# Set to 'true' only on the very first deploy to create default admin/seed data.
# Set back to 'false' after the first deployment completes.
# ------------------------------------------------------------------------------
RUN_SEEDER=true

VITE_APP_NAME="${APP_NAME}"
